---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Absolute, so the nav also works from the 404 page, where a bare
// fragment would only move the hash and leave the visitor on the error page.
const links = [
  { href: `${base}/#features`, label: 'Features' },
  { href: `${base}/#install`, label: 'Install' },
  { href: `${base}/#keys`, label: 'Keys' },
  { href: `${base}/#themes`, label: 'Themes' },
];
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={`${base}/`}>
      <span class="brand__prompt">$</span>
      <span class="brand__name">bsky</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav__cta" href="https://github.com/jedipunkz/bsky">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    padding: 0.5rem 0.85rem;
    background: var(--ctp-surface0);
    border-radius: 6px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--ctp-crust) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
  }

  .brand:hover {
    text-decoration: none;
    color: var(--ctp-lavender);
  }

  .brand__prompt {
    color: var(--ctp-green);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.92rem;
  }

  .nav a {
    color: var(--fg-muted);
  }

  .nav a:hover {
    color: var(--fg);
    text-decoration: none;
  }

  .nav__cta {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--ctp-lavender) !important;
  }

  .nav__cta:hover {
    border-color: var(--ctp-lavender);
    background: color-mix(in srgb, var(--ctp-lavender) 12%, transparent);
  }

  @media (max-width: 620px) {
    .nav {
      gap: 0.85rem;
      font-size: 0.85rem;
    }
    .nav a:not(.nav__cta) {
      display: none;
    }
  }
</style>

---
interface Props {
  title?: string;
}

const { title = 'bsky' } = Astro.props;
---

<div class="term">
  <div class="term__bar">
    <span class="term__dot term__dot--red"></span>
    <span class="term__dot term__dot--yellow"></span>
    <span class="term__dot term__dot--green"></span>
    <span class="term__title">{title}</span>
  </div>
  <div class="term__body">
    <slot />
  </div>
</div>

<style>
  .term {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--ctp-crust);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(17, 17, 27, 0.9);
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    background: var(--ctp-mantle);
    border-bottom: 1px solid var(--border);
  }

  .term__dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
  }

  .term__dot--red { background: var(--ctp-red); }
  .term__dot--yellow { background: var(--ctp-yellow); }
  .term__dot--green { background: var(--ctp-green); }

  .term__title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
  }

  .term__body {
    padding: 1rem 1.1rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    overflow-x: auto;
  }
</style>
